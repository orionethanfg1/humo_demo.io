---
import { aiAnnouncementBg } from '../data/aiAnnouncementBg';

const base = import.meta.env.BASE_URL;
---

<section
  id="ia"
  class="ai-announce relative overflow-hidden border-y border-accent-500/20"
  aria-labelledby="ai-announce-title"
>
  <div class="ai-announce__bg" aria-hidden="true">
    <img
      src={aiAnnouncementBg}
      alt=""
      class="ai-announce__photo"
      width="960"
      height="644"
      loading="eager"
      decoding="async"
    />
    <div class="ai-announce__veil"></div>
  </div>

  <div class="container-humo relative z-10 py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-4xl text-center" data-reveal>
      <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-accent-500/40 bg-black/40 backdrop-blur-sm px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-accent-400">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-400 opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-400"></span>
        </span>
        Nuevo en Humo
      </p>

      <h2 id="ai-announce-title" class="sr-only">
        Inteligencia Artificial a tu alcance
      </h2>

      <div class="ai-announce__stage" aria-hidden="true"></div>

      <p class="mx-auto mt-2 max-w-2xl text-base sm:text-lg leading-relaxed text-white/95 drop-shadow-md">
        Chatbots que entienden, automatizaciones que ahorran horas y herramientas que antes solo
        tenían las grandes empresas — ahora diseñadas para tu negocio, en días, no en meses.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`${base}#contacto`} class="btn-primary min-w-[200px] shadow-lg shadow-black/50">
          Quiero IA en mi negocio
        </a>
        <a href={`${base}demo/bot/`} class="btn-secondary min-w-[200px] backdrop-blur-sm bg-black/40 border-white/20">
          Probar demo con IA
        </a>
      </div>

      <ul class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-white/75">
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-accent-400 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Sin equipo de data science
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-accent-400 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          Resultados en días
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-accent-400 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          A la medida de tu giro
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .ai-announce {
    min-height: 28rem;
    isolation: isolate;
  }

  .ai-announce__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .ai-announce__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .ai-announce__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(10, 11, 12, 0.35) 0%,
        rgba(10, 11, 12, 0.1) 28%,
        rgba(10, 11, 12, 0.15) 50%,
        rgba(10, 11, 12, 0.75) 100%
      );
  }

  .ai-announce__stage {
    height: clamp(7.5rem, 22vw, 12rem);
  }

  @media (min-width: 640px) {
    .ai-announce {
      min-height: 32rem;
    }
    .ai-announce__stage {
      height: clamp(9rem, 18vw, 14rem);
    }
  }
</style>
