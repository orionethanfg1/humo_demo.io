---
const base = import.meta.env.BASE_URL;
---

<section
  id="ia"
  class="ai-announce relative overflow-hidden border-y border-accent-500/20"
  aria-labelledby="ai-announce-title"
>
  <!-- Fondo atmosférico (CSS) — nítido, sin dependencias de binarios/data-URI -->
  <div class="ai-announce__bg" aria-hidden="true">
    <div class="ai-announce__aurora"></div>
    <div class="ai-announce__grid"></div>
    <div class="ai-announce__veil"></div>
  </div>

  <div class="container-humo relative z-10 py-16 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-4xl text-center" data-reveal>
      <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-accent-500/40 bg-black/40 backdrop-blur-sm px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-accent-400">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-400 opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-400"></span>
        </span>
        Nuevo en Humo
      </p>

      <h2
        id="ai-announce-title"
        class="ai-announce__title font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-white"
      >
        Inteligencia Artificial
        <span class="block text-accent-400 mt-1 sm:mt-2">a tu alcance</span>
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-white/95 drop-shadow-md">
        Chatbots que entienden, automatizaciones que ahorran horas y herramientas que antes solo
        tenían las grandes empresas — ahora diseñadas para tu negocio, en días, no en meses.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`${base}#contacto`} class="btn-primary min-w-[200px] shadow-lg shadow-black/50">
          Quiero IA en mi negocio
        </a>
        <a
          href={`${base}demo/bot/`}
          class="btn-secondary min-w-[200px] backdrop-blur-sm bg-black/40 border-white/20"
        >
          Probar demo con IA
        </a>
      </div>

      <ul class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-white/75">
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-accent-400 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Sin equipo de data science
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-accent-400 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Resultados en días
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-accent-400 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          A la medida de tu giro
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .ai-announce {
    min-height: 28rem;
    isolation: isolate;
    background: #0a0b0c;
  }

  .ai-announce__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Aurora / smoke teal — estética Humo */
  .ai-announce__aurora {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(ellipse 80% 60% at 20% 40%, rgba(45, 212, 191, 0.28) 0%, transparent 55%),
      radial-gradient(ellipse 70% 50% at 80% 30%, rgba(20, 184, 166, 0.22) 0%, transparent 50%),
      radial-gradient(ellipse 60% 40% at 50% 80%, rgba(13, 148, 136, 0.18) 0%, transparent 45%),
      radial-gradient(ellipse 50% 30% at 60% 20%, rgba(94, 234, 212, 0.12) 0%, transparent 40%),
      linear-gradient(160deg, #0a0b0c 0%, #0f1419 40%, #0a0b0c 100%);
    animation: ai-aurora 18s ease-in-out infinite alternate;
  }

  .ai-announce__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(45, 212, 191, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(45, 212, 191, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 70%);
    opacity: 0.7;
  }

  .ai-announce__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(10, 11, 12, 0.35) 0%,
        rgba(10, 11, 12, 0.15) 40%,
        rgba(10, 11, 12, 0.55) 75%,
        rgba(10, 11, 12, 0.92) 100%
      );
  }

  .ai-announce__title {
    text-shadow:
      0 2px 24px rgba(0, 0, 0, 0.85),
      0 0 40px rgba(0, 0, 0, 0.5),
      0 0 80px rgba(45, 212, 191, 0.15);
    letter-spacing: -0.02em;
  }

  @keyframes ai-aurora {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-2%, 1%) scale(1.05); }
  }

  @media (min-width: 640px) {
    .ai-announce {
      min-height: 32rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-announce__aurora {
      animation: none;
    }
    .ai-announce__title {
      text-shadow: 0 1px 8px rgba(0, 0, 0, 0.7);
    }
  }
</style>
