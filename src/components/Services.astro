---
const services = [
  {
    id: 'web',
    title: 'Página web rápida',
    description: 'Presencia profesional en internet lista para compartir en menos de una semana. Diseño moderno, responsive y optimizado.',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg>`,
    value: 'Presencia digital lista para compartir',
  },
  {
    id: 'chatbot',
    title: 'Chatbot de WhatsApp',
    description: 'Atiende horarios, agenda citas y envía recordatorios automáticamente. Tu equipo ahorra tiempo y el cliente recibe respuesta inmediata.',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" /></svg>`,
    value: 'Atención 24/7 sin aumentar personal',
  },
  {
    id: 'dashboard',
    title: 'Dashboard automático',
    description: 'Ventas, productos más vendidos y reportes claros en gráficas. Control de tu negocio sin sistemas caros ni hojas de cálculo eternas.',
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>`,
    value: 'Decisiones basadas en datos reales',
  },
];
---

<section id="servicios" class="py-20 sm:py-28">
  <div class="container-humo">
    <div class="mx-auto max-w-2xl text-center mb-14">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Lo que resolvemos
      </h2>
      <p class="mt-4 text-lg text-text-secondary">
        Tres soluciones concretas que puedes tener funcionando en pocos días.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <article class="card-humo p-6 sm:p-8 flex flex-col">
          <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent-500/10 text-accent-400" set:html={s.icon} />
          <h3 class="text-xl font-semibold text-text-primary">{s.title}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-text-secondary">{s.description}</p>
          <p class="mt-5 text-sm font-medium text-accent-400">{s.value}</p>
        </article>
      ))}
    </div>
  </div>
</section>
