---
const WA_BASE = 'https://wa.me/523335982161';
---

<div id="humo-demo-chat" class="humo-chat" data-wa-base={WA_BASE}>
  <div
    id="humo-chat-panel"
    class="humo-chat__panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="humo-chat-title"
    data-state="closed"
    hidden
  >
    <header class="humo-chat__header">
      <div class="flex items-center gap-2.5 min-w-0">
        <span class="h-2 w-2 rounded-full bg-accent-500 shrink-0 animate-pulse" aria-hidden="true"></span>
        <div class="min-w-0">
          <p id="humo-chat-title" class="text-sm font-semibold text-text-primary truncate">Asistente Humo</p>
          <p class="text-xs text-text-muted">Demo interactiva · no es un bot real aún</p>
        </div>
      </div>
      <button type="button" id="humo-chat-close" class="humo-chat__icon-btn" aria-label="Cerrar chat">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </header>

    <div id="humo-chat-messages" class="humo-chat__messages" aria-live="polite"></div>
    <div id="humo-chat-actions" class="humo-chat__actions"></div>
  </div>

  <button
    type="button"
    id="humo-chat-toggle"
    class="humo-chat__toggle"
    aria-expanded="false"
    aria-controls="humo-chat-panel"
    aria-label="Abrir asistente de demo"
  >
    <span class="humo-chat__toggle-icon" aria-hidden="true">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
      </svg>
    </span>
    <span class="humo-chat__toggle-close" aria-hidden="true">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </span>
  </button>
</div>

<script>
  const FLOW = {
    start: {
      id: 'start',
      bot: '¡Hola! Soy el asistente demo de Humo. ¿Qué te interesa explorar?',
      options: [
        { label: 'Página web rápida', next: 'web', value: 'web' },
        { label: 'Chatbot de WhatsApp', next: 'chatbot', value: 'chatbot' },
        { label: 'Dashboard automático', next: 'dashboard', value: 'dashboard' },
        { label: 'Aún no lo sé', next: 'unsure', value: 'asesoria' },
      ],
    },
    web: {
      id: 'web',
      bot: 'Perfecto. En pocos días puedes tener una página como esta: moderna, rápida y lista para compartir. ¿Quieres que te armemos una propuesta?',
      options: [
        { label: 'Sí, por WhatsApp', next: 'wa', value: 'web' },
        { label: 'Ver otras opciones', next: 'start' },
      ],
    },
    chatbot: {
      id: 'chatbot',
      bot: 'Un chatbot puede responder horarios, agendar y mandar recordatorios 24/7. Ideal para clínicas, restaurantes y servicios. ¿Lo vemos para tu negocio?',
      options: [
        { label: 'Sí, por WhatsApp', next: 'wa', value: 'chatbot' },
        { label: 'Ver otras opciones', next: 'start' },
      ],
    },
    dashboard: {
      id: 'dashboard',
      bot: 'Con un dashboard ves ventas, platos top y reportes automáticos — como el demo de Brasa Fina. Control real sin sistemas caros. ¿Te interesa?',
      options: [
        { label: 'Sí, por WhatsApp', next: 'wa', value: 'dashboard' },
        { label: 'Ver otras opciones', next: 'start' },
      ],
    },
    unsure: {
      id: 'unsure',
      bot: 'Sin problema. Cuéntanos tu negocio y te recomendamos la solución más simple. ¿Seguimos por WhatsApp?',
      options: [
        { label: 'Escribir por WhatsApp', next: 'wa', value: 'asesoria' },
        { label: 'Ver las 3 opciones', next: 'start' },
      ],
    },
  };

  function initDemoChat() {
    const root = document.getElementById('humo-demo-chat');
    if (!root || root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    const waBase = root.dataset.waBase || 'https://wa.me/523335982161';
    const toggle = document.getElementById('humo-chat-toggle');
    const panel = document.getElementById('humo-chat-panel');
    const closeBtn = document.getElementById('humo-chat-close');
    const messages = document.getElementById('humo-chat-messages');
    const actions = document.getElementById('humo-chat-actions');

    if (!toggle || !panel || !messages || !actions) return;

    let interest = 'solución digital';
    let openedOnce = false;
    let closingTimer = null;

    function openPanel() {
      if (closingTimer) {
        clearTimeout(closingTimer);
        closingTimer = null;
      }
      panel.hidden = false;
      void panel.offsetWidth;
      panel.dataset.state = 'open';
      toggle.setAttribute('aria-expanded', 'true');
      root.classList.add('humo-chat--open');
      if (!openedOnce) {
        openedOnce = true;
        renderStep('start');
      }
    }

    function closePanel() {
      panel.dataset.state = 'closing';
      toggle.setAttribute('aria-expanded', 'false');
      root.classList.remove('humo-chat--open');
      closingTimer = setTimeout(function () {
        panel.hidden = true;
        panel.dataset.state = 'closed';
        closingTimer = null;
      }, 220);
    }

    function appendTyping() {
      const row = document.createElement('div');
      row.className = 'humo-chat__row humo-chat__row--bot';
      row.dataset.typing = '1';
      const dots = document.createElement('div');
      dots.className = 'humo-chat__typing';
      dots.setAttribute('aria-hidden', 'true');
      dots.innerHTML = '<span></span><span></span><span></span>';
      row.appendChild(dots);
      messages.appendChild(row);
      messages.scrollTop = messages.scrollHeight;
      return row;
    }

    function appendBot(text) {
      const row = document.createElement('div');
      row.className = 'humo-chat__row humo-chat__row--bot';
      const bubble = document.createElement('div');
      bubble.className = 'humo-chat__bubble humo-chat__bubble--bot';
      bubble.textContent = text;
      row.appendChild(bubble);
      messages.appendChild(row);
      messages.scrollTop = messages.scrollHeight;
    }

    function appendUser(text) {
      const row = document.createElement('div');
      row.className = 'humo-chat__row humo-chat__row--user';
      const bubble = document.createElement('div');
      bubble.className = 'humo-chat__bubble humo-chat__bubble--user';
      bubble.textContent = text;
      row.appendChild(bubble);
      messages.appendChild(row);
      messages.scrollTop = messages.scrollHeight;
    }

    function buildWaUrl(topic) {
      const msg = 'Hola Humo, me interesa: ' + topic + '. Vi la demo en la página y quiero una propuesta.';
      return waBase + '?text=' + encodeURIComponent(msg);
    }

    function renderStep(stepId) {
      const step = FLOW[stepId];
      if (!step) return;

      actions.innerHTML = '';
      const typing = appendTyping();

      setTimeout(function () {
        typing.remove();
        appendBot(step.bot);
        if (!step.options) return;

        for (const opt of step.options) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'humo-chat__option';
          btn.textContent = opt.label;

          btn.addEventListener('click', function () {
            appendUser(opt.label);
            actions.innerHTML = '';
            if (opt.value) interest = opt.value;

            if (opt.next === 'wa') {
              const typingWa = appendTyping();
              setTimeout(function () {
                typingWa.remove();
                const url = buildWaUrl(interest);
                appendBot('Te abro WhatsApp con el mensaje listo. ¡Hablamos!');
                const link = document.createElement('a');
                link.href = url;
                link.target = '_blank';
                link.rel = 'noopener noreferrer';
                link.className = 'humo-chat__wa';
                link.textContent = 'Continuar en WhatsApp';
                actions.appendChild(link);

                const again = document.createElement('button');
                again.type = 'button';
                again.className = 'humo-chat__option humo-chat__option--ghost';
                again.textContent = 'Empezar de nuevo';
                again.addEventListener('click', function () {
                  messages.innerHTML = '';
                  interest = 'solución digital';
                  renderStep('start');
                });
                actions.appendChild(again);
              }, 420);
              return;
            }

            setTimeout(function () {
              renderStep(opt.next);
            }, 320);
          });

          actions.appendChild(btn);
        }
      }, 480);
    }

    toggle.addEventListener('click', function () {
      if (panel.hidden || panel.dataset.state === 'closed' || panel.dataset.state === 'closing') {
        openPanel();
      } else {
        closePanel();
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closePanel);
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && panel.dataset.state === 'open') closePanel();
    });
  }

  initDemoChat();
  document.addEventListener('astro:page-load', initDemoChat);
</script>
