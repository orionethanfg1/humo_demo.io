---
const services = [
  { id: 'web', label: 'Página web rápida' },
  { id: 'chatbot', label: 'Chatbot de WhatsApp' },
  { id: 'dashboard', label: 'Dashboard automático' },
  { id: 'asesoria', label: 'Aún no lo sé / asesoría' },
];

const timelines = [
  { id: 'urgente', label: 'Esta semana' },
  { id: 'pronto', label: 'En 2–4 semanas' },
  { id: 'explorando', label: 'Solo estoy explorando' },
];
---

<section id="contacto" class="py-20 sm:py-28">
  <div class="container-humo">
    <div class="mx-auto max-w-2xl text-center mb-10" data-reveal>
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        ¿Listo para tener tu solución digital?
      </h2>
      <p class="mt-4 text-lg text-text-secondary">
        Elige qué necesitas y te abrimos WhatsApp con el mensaje listo. Respuesta habitual en menos de 24 horas.
      </p>
    </div>

    <form
      id="humo-quote-form"
      class="mx-auto max-w-lg card-humo card-humo--interactive p-6 sm:p-8 space-y-6"
      data-wa-base="https://wa.me/523335982161"
      data-reveal
    >
      <div>
        <label for="quote-service" class="block text-sm font-medium text-text-primary mb-2">
          ¿Qué necesitas?
        </label>
        <select id="quote-service" name="service" required class="humo-input">
          <option value="" disabled selected>Selecciona una opción</option>
          {services.map((s) => (
            <option value={s.label}>{s.label}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="quote-timeline" class="block text-sm font-medium text-text-primary mb-2">
          ¿Para cuándo?
        </label>
        <select id="quote-timeline" name="timeline" required class="humo-input">
          <option value="" disabled selected>Selecciona una opción</option>
          {timelines.map((t) => (
            <option value={t.label}>{t.label}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="quote-name" class="block text-sm font-medium text-text-primary mb-2">
          Tu nombre <span class="text-text-muted font-normal">(opcional)</span>
        </label>
        <input
          id="quote-name"
          name="name"
          type="text"
          autocomplete="name"
          placeholder="Ej. Ana"
          class="humo-input"
        />
      </div>

      <button type="submit" class="btn-primary w-full text-base">
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Continuar en WhatsApp
      </button>

      <p class="text-center text-xs text-text-muted">
        No enviamos formularios a servidores: el mensaje se abre en tu WhatsApp.
      </p>
    </form>
  </div>
</section>

<script>
  function initQuoteForm() {
    const form = document.getElementById('humo-quote-form');
    if (!form || form.dataset.ready === '1') return;
    form.dataset.ready = '1';

    const waBase = form.dataset.waBase || 'https://wa.me/523335982161';

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const service = String(data.get('service') || '').trim();
      const timeline = String(data.get('timeline') || '').trim();
      const name = String(data.get('name') || '').trim();

      if (!service || !timeline) return;

      const lines = [
        'Hola Humo,',
        name ? `Soy ${name}.` : '',
        `Me interesa: ${service}.`,
        `Timeline: ${timeline}.`,
        'Vi la demo en la página y quiero una propuesta.',
      ].filter(Boolean);

      const url = `${waBase}?text=${encodeURIComponent(lines.join(' '))}`;
      window.open(url, '_blank', 'noopener,noreferrer');
      showToast('Mensaje listo en WhatsApp');
    });
  }

  function showToast(message) {
    let toast = document.getElementById('humo-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'humo-toast';
      toast.className = 'humo-toast';
      toast.setAttribute('role', 'status');
      document.body.appendChild(toast);
    }
    toast.textContent = message;
    toast.classList.add('is-on');
    clearTimeout(showToast._t);
    showToast._t = setTimeout(() => toast.classList.remove('is-on'), 2800);
  }

  initQuoteForm();
  document.addEventListener('astro:page-load', initQuoteForm);
</script>
