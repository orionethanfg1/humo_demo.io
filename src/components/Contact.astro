---
const services = [
  { id: 'web', label: 'Página web rápida' },
  { id: 'chatbot', label: 'Chatbot de WhatsApp' },
  { id: 'dashboard', label: 'Dashboard automático' },
  { id: 'asesoria', label: 'Aún no lo sé / asesoría' },
];

const timelines = [
  { id: 'urgente', label: 'Esta semana' },
  { id: 'pronto', label: 'En 2–4 semanas' },
  { id: 'explorando', label: 'Solo estoy explorando' },
];
---

<section id="contacto" class="py-20 sm:py-28">
  <div class="container-humo">
    <div class="mx-auto max-w-2xl text-center mb-10">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        ¿Listo para tener tu solución digital?
      </h2>
      <p class="mt-4 text-lg text-text-secondary">
        Elige qué necesitas y te abrimos WhatsApp con el mensaje listo. Respuesta habitual en menos de 24 horas.
      </p>
    </div>

    <form
      id="humo-quote-form"
      class="mx-auto max-w-lg card-humo p-6 sm:p-8 space-y-6"
      data-wa-base="https://wa.me/523335982161"
    >
      <div>
        <label for="quote-service" class="block text-sm font-medium text-text-primary mb-2">
          ¿Qué necesitas?
        </label>
        <select id="quote-service" name="service" required class="humo-input">
          <option value="" disabled selected>Selecciona una opción</option>
          {services.map((s) => (
            <option value={s.label}>{s.label}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="quote-timeline" class="block text-sm font-medium text-text-primary mb-2">
          ¿Para cuándo?
        </label>
        <select id="quote-timeline" name="timeline" required class="humo-input">
          <option value="" disabled selected>Selecciona una opción</option>
          {timelines.map((t) => (
            <option value={t.label}>{t.label}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="quote-name" class="block text-sm font-medium text-text-primary mb-2">
          Tu nombre <span class="text-text-muted font-normal">(opcional)</span>
        </label>
        <input id="quote-name" name="name" type="text" autocomplete="name" placeholder="Ej. Ana" class="humo-input" />
      </div>

      <button type="submit" class="btn-primary w-full text-base">
        Continuar en WhatsApp
      </button>

      <p class="text-center text-xs text-text-muted">
        No enviamos formularios a servidores: el mensaje se abre en tu WhatsApp.
      </p>
    </form>
  </div>
</section>

<script>
  function initQuoteForm() {
    const form = document.getElementById('humo-quote-form');
    if (!form || form.dataset.ready === '1') return;
    form.dataset.ready = '1';
    const waBase = form.dataset.waBase || 'https://wa.me/523335982161';
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const service = String(data.get('service') || '').trim();
      const timeline = String(data.get('timeline') || '').trim();
      const name = String(data.get('name') || '').trim();
      if (!service || !timeline) return;
      const lines = [
        'Hola Humo,',
        name ? 'Soy ' + name + '.' : '',
        'Me interesa: ' + service + '.',
        'Timeline: ' + timeline + '.',
        'Vi la demo en la página y quiero una propuesta.',
      ].filter(Boolean);
      const url = waBase + '?text=' + encodeURIComponent(lines.join(' '));
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  }
  initQuoteForm();
  document.addEventListener('astro:page-load', initQuoteForm);
</script>
