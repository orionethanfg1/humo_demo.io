---
const base = import.meta.env.BASE_URL;
---

<header class="sticky top-0 z-50 border-b border-smoke-800/50 bg-surface/80 backdrop-blur-md">
  <div class="container-humo flex h-16 items-center justify-between">
    <a href={base} class="flex items-center gap-2.5 group" aria-label="Humo - Inicio">
      <!-- Logo SVG: monograma H con volutas de humo -->
      <svg class="h-8 w-8 text-accent-500 transition-transform group-hover:scale-105" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M8 28C8 20 12 14 20 12C28 14 32 20 32 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.9"/>
        <path d="M12 24C12 18 15 14 20 13C25 14 28 18 28 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.6"/>
        <path d="M16 20C16 17 17.5 15 20 14.5C22.5 15 24 17 24 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
        <text x="20" y="32" text-anchor="middle" fill="currentColor" font-size="11" font-weight="700" font-family="Inter, sans-serif">H</text>
      </svg>
      <span class="text-lg font-semibold tracking-tight text-text-primary">Humo</span>
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-text-secondary" aria-label="Navegación principal">
      <a href="#servicios" class="hover:text-accent-400 transition-colors">Servicios</a>
      <a href="#proceso" class="hover:text-accent-400 transition-colors">Cómo trabajamos</a>
      <a href="#demos" class="hover:text-accent-400 transition-colors">Demos</a>
      <a href="#contacto" class="hover:text-accent-400 transition-colors">Contacto</a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="https://wa.me/523335982161?text=Hola%20Humo%2C%20me%20interesa%20una%20soluci%C3%B3n%20digital"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary text-xs sm:text-sm px-4 py-2.5"
      >
        WhatsApp
      </a>
      <!-- Menú móvil simple -->
      <button
        id="menu-toggle"
        class="md:hidden p-2 rounded-lg text-text-secondary hover:bg-smoke-800/50"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-smoke-800/50 bg-surface-elevated">
    <nav class="container-humo flex flex-col gap-1 py-4 text-sm font-medium" aria-label="Menú móvil">
      <a href="#servicios" class="px-3 py-2.5 rounded-lg hover:bg-smoke-800/40 text-text-secondary hover:text-accent-400">Servicios</a>
      <a href="#proceso" class="px-3 py-2.5 rounded-lg hover:bg-smoke-800/40 text-text-secondary hover:text-accent-400">Cómo trabajamos</a>
      <a href="#demos" class="px-3 py-2.5 rounded-lg hover:bg-smoke-800/40 text-text-secondary hover:text-accent-400">Demos</a>
      <a href="#contacto" class="px-3 py-2.5 rounded-lg hover:bg-smoke-800/40 text-text-secondary hover:text-accent-400">Contacto</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
  // Cerrar al hacer click en un enlace
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
