---
const base = import.meta.env.BASE_URL;

const demos = [
  {
    id: 'web',
    title: 'Página web rápida',
    subtitle: 'Presencia digital',
    description:
      'Variantes por industria (clínica, restaurante, retail). Misma estructura, mensaje a medida — lista para compartir.',
    status: 'En vivo',
    href: `${base}demo/web/`,
    cta: 'Abrir demo web',
  },
  {
    id: 'sonrisas',
    title: 'Sonrisas MX',
    subtitle: 'Chatbot tipo WhatsApp',
    description:
      'Agenda citas, horarios, precios y recordatorios. Motor de reglas 100% local + descarga de calendario (.ics).',
    status: 'En vivo',
    href: `${base}demo/bot/`,
    cta: 'Abrir demo chatbot',
  },
  {
    id: 'brasa',
    title: 'Brasa Fina',
    subtitle: 'Dashboard de ventas',
    description:
      'KPIs, gráfica interactiva, platos top, hoja editable y export CSV. Sin Google Sheets ni Looker.',
    status: 'En vivo',
    href: `${base}demo/dash/`,
    cta: 'Abrir demo dashboard',
  },
];
---

<section id="demos" class="py-20 sm:py-28">
  <div class="container-humo">
    <div class="mx-auto max-w-2xl text-center mb-14" data-reveal>
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Demos en vivo</h2>
      <p class="mt-4 text-lg text-text-secondary">
        Muestras reales que puedes probar ahora. Todo corre en el navegador — sin cuentas de terceros.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        demos.map((d, i) => (
          <article
            class="card-humo card-humo--interactive p-6 flex flex-col"
            data-reveal
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-accent-500/15 text-accent-400">
                {d.status}
              </span>
            </div>
            <h3 class="text-lg font-semibold text-text-primary">{d.title}</h3>
            <p class="text-sm text-accent-400 mt-1">{d.subtitle}</p>
            <p class="mt-3 flex-1 text-sm text-text-secondary leading-relaxed">{d.description}</p>
            <a href={d.href} class="btn-secondary mt-5 w-full text-sm text-center">
              {d.cta}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
