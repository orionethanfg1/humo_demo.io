---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showWordmark?: boolean;
  class?: string;
}

const { size = 'md', showWordmark = true, class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const logoSrc = `${base}images/Humo_logo.jpg`;

const sizes = {
  sm: { icon: 'h-8 w-auto', text: 'text-base' },
  md: { icon: 'h-10 w-auto', text: 'text-lg' },
  lg: { icon: 'h-14 w-auto', text: 'text-2xl' },
};
const s = sizes[size];
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <img
    src={logoSrc}
    alt=""
    width="128"
    height="94"
    class={`${s.icon} shrink-0 object-contain drop-shadow-[0_0_14px_rgba(45,212,191,0.3)]`}
    decoding="async"
  />
  {
    showWordmark && (
      <span class={`${s.text} font-semibold tracking-[0.14em] text-text-primary uppercase`}>Humo</span>
    )
  }
</span>
