---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-smoke-800/50 py-12">
  <div class="container-humo flex flex-col items-center gap-6 text-center sm:flex-row sm:justify-between sm:text-left">
    <div class="flex flex-col items-center gap-3 sm:items-start">
      <Logo size="md" />
      <p class="text-sm text-text-muted max-w-xs">
        Soluciones digitales claras, r\u00e1pidas y a tu medida.
      </p>
    </div>
    <p class="text-sm text-text-muted">
      \u00a9 {year} Humo
    </p>
  </div>
</footer>
