---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="border-t border-smoke-800/50 py-10">
  <div class="container-humo flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2.5">
      <svg class="h-6 w-6 text-accent-500" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M8 28C8 20 12 14 20 12C28 14 32 20 32 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.9"/>
        <path d="M12 24C12 18 15 14 20 13C25 14 28 18 28 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.6"/>
        <text x="20" y="32" text-anchor="middle" fill="currentColor" font-size="11" font-weight="700" font-family="Inter, sans-serif">H</text>
      </svg>
      <span class="font-semibold text-text-primary">Humo</span>
    </div>
    <p class="text-sm text-text-muted">
      © {year} Humo. Soluciones digitales claras, rápidas y a tu medida.
    </p>
  </div>
</footer>
